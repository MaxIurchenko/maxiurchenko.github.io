ehind the numbers through exploration, modeling, and clear visual insights that support better decisions."}]},{"name":"Expertise Tags","classes":["intro-tags"],"components":[{"tagName":"span","type":"text","name":"Skill Tag","classes":["skill-tag"],"components":[{"type":"textnode","content":"Analytics"}]},{"tagName":"span","type":"text","name":"Skill Tag","classes":["skill-tag"],"components":[{"type":"textnode","content":"Modeling"}]},{"tagName":"span","type":"text","name":"Skill Tag","classes":["skill-tag"],"components":[{"type":"textnode","content":"Visualization"}]}]}]}]},{"name":"Slider Controls","classes":["intro-controls"],"components":[{"name":"Slide Indicators","classes":["intro-dots"],"attributes":{"role":"group","aria-label":"Choose expertise slide"},"components":[{"type":"button","name":"Slide Indicator","classes":["intro-dot","intro-dot-active"],"attributes":{"type":"button","aria-label":"Show Robotics","aria-current":"true","data-js":"dot"},"components":[{"type":"contentEditable","components":[{"tagName":"span","name":"Indicator Mark","classes":["intro-dot-mark"]}]}]},{"type":"button","name":"Slide Indicator","classes":["intro-dot"],"attributes":{"type":"button","aria-label":"Show Artificial Intelligence","data-js":"dot"},"components":[{"type":"contentEditable","components":[{"tagName":"span","name":"Indicator Mark","classes":["intro-dot-mark"]}]}]},{"type":"button","name":"Slide Indicator","classes":["intro-dot"],"attributes":{"type":"button","aria-label":"Show Automation","data-js":"dot"},"components":[{"type":"contentEditable","components":[{"tagName":"span","name":"Indicator Mark","classes":["intro-dot-mark"]}]}]},{"type":"button","name":"Slide Indicator","classes":["intro-dot"],"attributes":{"type":"button","aria-label":"Show Software Development","data-js":"dot"},"components":[{"type":"contentEditable","components":[{"tagName":"span","name":"Indicator Mark","classes":["intro-dot-mark"]}]}]},{"type":"button","name":"Slide Indicator","classes":["intro-dot"],"attributes":{"type":"button","aria-label":"Show Data Science","data-js":"dot"},"components":[{"type":"contentEditable","components":[{"tagName":"span","name":"Indicator Mark","classes":["intro-dot-mark"]}]}]}]},{"name":"Slider Navigation","classes":["intro-control-buttons"],"components":[{"type":"button","name":"Autoplay Control","classes":["intro-control"],"attributes":{"type":"button","data-js":"rotation","aria-label":"Pause automatic slides"},"components":[{"type":"contentEditable","components":[{"type":"textnode","content":"Pause"}]}]},{"type":"button","name":"Previous Slide","classes":["intro-control"],"attributes":{"type":"button","data-js":"previous","aria-label":"Previous slide"},"components":[{"type":"contentEditable","components":[{"type":"image","name":"Previous Arrow","resizable":{"ratioDefault":1},"classes":["intro-control-icon"],"attributes":{"src":"https://api.iconify.design/lucide-arrow-left.svg?color=%23cbd5e1","alt":""}}]}]},{"type":"button","name":"Next Slide","classes":["intro-control"],"attributes":{"type":"button","data-js":"next","aria-label":"Next slide"},"components":[{"type":"contentEditable","components":[{"type":"image","name":"Next Arrow","resizable":{"ratioDefault":1},"classes":["intro-control-icon"],"attributes":{"src":"https://api.iconify.design/lucide-arrow-right.svg?color=%23cbd5e1","alt":""}}]}]}]}]}]},{"name":"Introduction Actions","classes":["hero-actions","intro-actions"],"components":[{"type":"link","name":"View Projects Link","classes":["gjs-t-button","primary-button"],"attributes":{"href":"#projects"},"components":[{"type":"textnode","content":"View My Projects"}]},{"type":"link","name":"Contact Link","classes":["gjs-t-link","secondary-button"],"attributes":{"href":"#contact"},"components":[{"type":"textnode","content":"Let’s Work Together"}]}]}]},{"type":"script","name":"Expertise Carousel Behavior","attributes":{"data-scope":"portfolio-intro"},"components":[{"type":"textnode","content":"\n(function(){\nconst root=document.querySelector('[data-js=\"portfolio-intro\"]');\nif(!root)return;\nconst carousel=root.querySelector('[data-js=\"carousel\"]');\nconst slides=Array.from(root.querySelectorAll('[data-js=\"slide\"]'));\nconst dots=Array.from(root.querySelectorAll('[data-js=\"dot\"]'));\nconst rotation=root.querySelector('[data-js=\"rotation\"]');\nconst region=root.querySelector('[data-js=\"slides\"]');\nlet index=0,timer=null,hovering=false,paused=window.matchMedia('(prefers-reduced-motion: reduce)').matches;\nfunction show(value){\nindex=(value+slides.length)%slides.length;\nslides.forEach((slide,i)=>slide.hidden=i!==index);\ndots.forEach((dot,i)=>{\ndot.classList.toggle('intro-dot-active',i===index);\nif(i===index)dot.setAttribute('aria-current','true');else dot.removeAttribute('aria-current');\n});\n}\nfunction sync(){\nclearInterval(timer);\nrotation.textContent=paused?'Play':'Pause';\nrotation.setAttribute('aria-label',paused?'Start automatic slides':'Pause automatic slides');\nregion.setAttribute('aria-live',paused?'polite':'off');\nif(!paused&&!hovering&&!document.hidden)timer=setInterval(()=>show(index+1),5500);\n}\nfunction manual(value){paused=true;sync();show(value);}\nroot.querySelector('[data-js=\"previous\"]').addEventListener('click',()=>manual(index-1));\nroot.querySelector('[data-js=\"next\"]').addEventListener('click',()=>manual(index+1));\ndots.forEach((dot,i)=>dot.addEventListener('click',()=>manual(i)));\ncarousel.addEventListener('mouseenter',()=>{hovering=true;sync();});\ncarousel.addEventListener('mouseleave',()=>{hovering=false;sync();});\ncarousel.addEventListener('focusin',()=>{paused=true;sync();});\nrotation.addEventListener('click',()=>{paused=!paused;sync();});\ncarousel.addEventListener('keydown',event=>{\nif(event.key==='ArrowLeft'||event.key==='ArrowRight'){\nevent.preventDefault();manual(index+(event.key==='ArrowRight'?1:-1));\n}\n});\ndocument.addEventListener('visibilitychange',sync);\nshow(0);sync();\n})();\n"}]}]}]},{"name":"Divider","classes":["section-line","divider"]},{"tagName":"section","name":"About Section","classes":["about-section"],"attributes":{"id":"about"},"components":[{"name":"Section Header","classes":["section-header"],"components":[{"tagName":"p","type":"text","name":"Section Eyebrow","classes":["section-eyebrow"],"components":[{"type":"textnode","content":"About Me"}]},{"tagName":"h2","type":"heading","name":"Section Title","classes":["gjs-t-h2","font-display","section-title"],"components":[{"type":"textnode","content":"A multidisciplinary engineer focused on practical intelligence."}]},{"tagName":"p","type":"text","name":"Section Description","classes":["section-description"],"components":[{"type":"textnode","content":"\n            My work sits at the intersection of robotics, AI, automation, software engineering, and data science. I enjoy building systems that sense, learn, decide, and execute. Whether the challenge is optimizing industrial workflows, creating smart software products, analyzing data for insight, or integrating machine intelligence into physical systems, I bring a complete engineering perspective to the solution.\n          "}]}]},{"name":"About Grid","classes":["about-grid"],"components":[{"name":"About Story Card","classes":["card-glow","gjs-t-border","about-story-card"],"components":[{"name":"Card Header","classes":["card-header"],"components":[{"name":"Header Content","classes":["header-content"],"components":[{"tagName":"h3","type":"heading","name":"Card Title","classes":["font-display","card-title"],"components":[{"type":"textnode","content":"What I bring"}]},{"tagName":"p","type":"text","name":"Card Subtitle","classes":["card-subtitle"],"components":[{"type":"textnode","content":"Technical depth with a product and systems mindset."}]}]},{"type":"text","name":"Highlight Badge","classes":["highlight-badge"],"components":[{"type":"textnode","content":"Portfolio-ready profile"}]}]},{"name":"About Features","classes":["about-features"],"components":[{"name":"Feature Item","classes":["feature-item"],"components":[{"tagName":"h4","type":"heading","name":"Feature Title","classes":["feature-title"],"components":[{"type":"textnode","content":"Systems Thinking"}]},{"tagName":"p","type":"text","name":"Feature Text","classes":["feature-text"],"components":[{"type":"textnode","content":"I design complete workflows from data acquisition and model training to deployment, monitoring, and optimization."}]}]},{"name":"Feature Item","classes":["feature-item"],"components":[{"tagName":"h4","type":"heading","name":"Feature Title","classes":["feature-title"],"components":[{"type":"textnode","content":"Real-World Automation"}]},{"tagName":"p","type":"text","name":"Feature Text","classes":["feature-text"],"components":[{"type":"textnode","content":"I focus on reducing manual work, improving reliability, and building repeatable processes through automation."}]}]},{"name":"Feature Item","classes":["feature-item"],"components":[{"tagName":"h4","type":"heading","name":"Feature Title","classes":["feature-title"],"components":[{"type":"textnode","content":"Applied AI"}]},{"tagName":"p","type":"text","name":"Feature Text","classes":["feature-text"],"components":[{"type":"textnode","content":"I use machine learning and intelligent algorithms to solve meaningful problems, not just to follow trends."}]}]},{"name":"Feature Item","classes":["feature-item"],"components":[{"tagName":"h4","type":"heading","name":"Feature Title","classes":["feature-title"],"components":[{"type":"textnode","content":"Scalable Software"}]},{"tagName":"p","type":"text","name":"Feature Text","classes":["feature-text"],"components":[{"type":"textnode","content":"I build maintainable applications, data tools, and service layers that support long-term growth and usability."}]}]}]}]},{"tagName":"aside","name":"Profile Summary Card","classes":["card-glow","gjs-t-border","profile-summary-card"],"components":[{"tagName":"h3","type":"heading","name":"Card Title","classes":["font-dis